# Local secrets — never commit (git-ignored).
# Mode: "mock" (no Uber calls, use simulator), "sandbox" (test-api.uber.com), "production"
UBER_MODE=mock
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=

# Passcode staff type to open the barista screen
STORE_PASSCODE=
# Random key used to sign the login cookie
SESSION_SECRET=

# Minutes we promise Uber an order will be ready after accepting
PREP_MINUTES=10
# Leave empty to use the built-in local database (~/.coffee-pos). Set to a Postgres URL in production.
DATABASE_URL=
